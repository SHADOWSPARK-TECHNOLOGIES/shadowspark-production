# ShadowSpark V1 Environment Configuration

# Authentication (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=https://your-production-domain.web.app

# WebAuthn (Passkeys)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ShadowSpark
WEBAUTHN_ORIGIN=http://localhost:3000
# Production values:
# WEBAUTHN_RP_ID=shadowspark-tech.org
# WEBAUTHN_RP_NAME=ShadowSpark
# WEBAUTHN_ORIGIN=https://shadowspark-tech.org

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/shadowspark?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/shadowspark?schema=public

# AI & Intelligence
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GOOGLE_AI_API_KEY=AIza...
FIRECRAWL_API_KEY=fc_...
JINA_API_KEY=jina_...

# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=...

# Email
RESEND_API_KEY=re_...
CONTACT_INBOX=hello@shadowspark.ng

# WhatsApp (Meta Business API)
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# OAuth Providers (set OAUTH_ENABLED=true to require these)
OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URLs:
# GitHub:  http://localhost:3000/api/auth/callback/github
# Google:  http://localhost:3000/api/auth/callback/google

# Internal API Secrets
LEAD_SYNC_SECRET=...
CRON_SECRET=...

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GCP
GOOGLE_CLOUD_PROJECT=...
CLOUD_SQL_CONNECTION_NAME=project:region:instance
VAULT_BUCKET=...

# RAG sync (optional overrides)
RAG_CRAWL_ROOT_URL=https://shadowspark-tech.org/blog
RAG_CRAWL_LIMIT=25
RAG_CHUNK_MAX_CHARS=1800
